<?xml version="1.0" encoding="utf-8"?>
<!--
  Style resources referenced by the vendored Termux :shared layouts. The upstream Termux tree ships
  these in res/values/styles.xml; this fork does not vendor that file, so we recreate only the keys
  actually used here. Each one delegates to an AppCompat ancestor so the look matches the platform.
-->
<resources>

    <!-- Toolbar title/subtitle text appearance used by partial_primary_toolbar.xml -->
    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?android:attr/textColorPrimaryInverse</item>
    </style>

    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">?android:attr/textColorSecondaryInverse</item>
    </style>

    <!--
      Vendored Termux MessageDialogUtils constructs an AlertDialog with the upstream Termux style
      Theme_AppCompat_Light_Dialog. AppCompat does not export that exact symbol — its dialog
      styles are Theme.AppCompat.Light.Dialog / .Dialog.Alert / .Dialog.MinWidth. We declare a
      thin wrapper here under a project-specific name (TermuxAppCompatLightDialog) so the R-class
      field exists without colliding with any framework/AppCompat style name. Previously this was
      named "Theme_AppCompat_Light_Dialog" which collided in :ide-android's merged resource set
      when :termux:shared was reachable on more than one dep path.
    -->
    <style name="TermuxAppCompatLightDialog" parent="Theme.AppCompat.Light.Dialog" />

</resources>
