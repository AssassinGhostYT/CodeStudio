<?xml version="1.0" encoding="utf-8"?>
<!--
  String resources referenced by the vendored Termux :application module. The upstream Termux tree
  ships a richer res/values/strings.xml that this fork doesn't vendor; this file restores the keys
  referenced from the Java sources so the module compiles and runtime lookups succeed.

  Format specifiers match what the calling sites pass to getString(...) — %1$s for a String, %1$d for an int.
  Where two args are used they're %1$s and %2$s.
-->
