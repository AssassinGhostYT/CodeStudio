<?xml version="1.0" encoding="utf-8"?>
<!-- TermuxActivity extends BaseIDEActivity → AppCompatActivity. AppCompat enforces that the
     activity's theme descend from Theme.AppCompat; the IDE's app theme (@android:style/Theme.Material.NoActionBar)
     is a SYSTEM theme that AppCompat does NOT recognise, so when Termux's onCreate runs,
     AppCompatDelegateImpl.createSubDecor throws IllegalStateException("You need to use a Theme.AppCompat
     theme") before any of Termux's own setup can run.

     Pointing TermuxActivity at Theme.AppCompat.DayNight.NoActionBar gives it the AppCompat decor
     AppCompatActivity requires, with DayNight so dark/light toggle still works. The previous attempt to
     use Theme.Material3.DayNight.NoActionBar was abandoned: activity_termux.xml's two buttons used
     MaterialButton + Widget.Material3.Button.TextButton, which still inflated with a Material3-style
     InflateException. Switching those buttons to plain android.widget.Button (see layout diff) removes
     the Material3 dependency entirely, so AppCompat is enough. -->
<resources>
    <style name="Theme.CodeStudio.Termux" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Termux paints its own UI over a black canvas; pin the window background so its full-bleed
             background lands correctly with no white flash during launch. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>